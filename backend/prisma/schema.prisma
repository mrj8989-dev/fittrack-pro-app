generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  TRAINER
  CLIENT
}

enum SubscriptionPlan {
  FREE
  PRO
  PREMIUM
}

model User {
  id               String           @id @default(uuid())
  email            String           @unique
  password         String
  name             String
  role             Role             @default(CLIENT)
  subscriptionPlan SubscriptionPlan @default(FREE)
  revisionInterval Int              @default(14)
  profilePhoto     String?
  // Cuentas desactivadas por un admin: no pueden iniciar sesión, pero conservan su historial.
  active           Boolean          @default(true)
  lastLoginAt      DateTime?
  // Contraseña puesta por un admin o entrenador: se pide cambiarla en el siguiente acceso.
  mustChangePassword Boolean        @default(false)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  trainerClients   User[]           @relation("TrainerClients")
  trainer          User?            @relation("TrainerClients", fields: [trainerId], references: [id])
  trainerId        String?

  workoutPlans     WorkoutPlan[]
  workoutSessions  WorkoutSession[]
  bodyRevisions    BodyRevision[]

  sentMessages     Message[]        @relation("SentMessages")
  receivedMessages Message[]        @relation("ReceivedMessages")

  customFoods      Food[]           @relation("CustomFoods")
  nutritionProfile NutritionProfile?
  mealPlans        MealPlan[]
  assignedMealPlans MealPlan[]      @relation("AssignedMealPlans")
  moduleOverrides  UserModuleOverride[]
  aiMessages       AiMessage[]
  aiSettings       AiSettings?
}

model Exercise {
  id           String   @id @default(uuid())
  name         String
  description  String?
  muscleGroup  String
  equipment    String?
  videoUrl     String?
  createdAt    DateTime @default(now())

  workoutExercises WorkoutExercise[]
}

model WorkoutPlan {
  id          String   @id @default(uuid())
  name        String
  description String?
  // Plantilla reutilizable del entrenador (o global si es del admin); no se entrena directamente.
  isTemplate  Boolean  @default(false)
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workouts    Workout[]
}

model Workout {
  id            String      @id @default(uuid())
  name          String
  dayOfWeek     Int?
  workoutPlanId String
  workoutPlan   WorkoutPlan @relation(fields: [workoutPlanId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now())

  exercises     WorkoutExercise[]
  sessions      WorkoutSession[]
}

model WorkoutExercise {
  id         String   @id @default(uuid())
  workoutId  String
  workout    Workout  @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  exerciseId String
  exercise   Exercise @relation(fields: [exerciseId], references: [id])
  sets       Int
  reps       Int?
  duration   Int?
  restTime   Int?
  order      Int
}

model WorkoutSession {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  // Si se borra el día del plan, la sesión se conserva en el historial con su nombre.
  workoutId   String?
  workout     Workout? @relation(fields: [workoutId], references: [id], onDelete: SetNull)
  workoutName String?
  date      DateTime @default(now())
  duration  Int?
  notes     String?
  completed Boolean  @default(false)

  sets      SessionSet[]
}

model SessionSet {
  id               String         @id @default(uuid())
  workoutSessionId String
  workoutSession   WorkoutSession @relation(fields: [workoutSessionId], references: [id], onDelete: Cascade)
  exerciseId       String
  setNumber        Int
  reps             Int?
  weight           Float?
  duration         Int?
  completed        Boolean        @default(false)
}

model BodyRevision {
  id              String   @id @default(uuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  date            DateTime @default(now())
  weight          Float
  bodyFat         Float?
  chestCm         Float?
  waistCm         Float?
  armsCm          Float?
  legsCm          Float?
  notes           String?
  photoFront      String?
  photoBack       String?
  photoSide       String?
  createdAt       DateTime @default(now())
}

model Message {
  id         String   @id @default(uuid())
  senderId   String
  sender     User     @relation("SentMessages", fields: [senderId], references: [id])
  receiverId String
  receiver   User     @relation("ReceivedMessages", fields: [receiverId], references: [id])
  content    String
  read       Boolean  @default(false)
  createdAt  DateTime @default(now())
}
// ── NUTRICIÓN ─────────────────────────────────────────────────────

enum FoodGroup {
  PROTEIN
  CARBS
  FATS
  VEGETABLES
  FRUITS
  OTHER
}

enum Sex {
  MALE
  FEMALE
}

enum ActivityLevel {
  SEDENTARY
  LIGHT
  MODERATE
  ACTIVE
  VERY_ACTIVE
}

enum NutritionGoal {
  LOSE_FAT
  MAINTAIN
  RECOMP
  GAIN_MUSCLE
}

// Catálogo común de alimentos, valores por 100 g en crudo. createdById = entrenador o admin
// que lo añadió (null = alimentos base del seed, que solo edita el admin).
model Food {
  id           String    @id @default(uuid())
  name         String
  group        FoodGroup
  kcal         Float
  protein      Float
  carbs        Float
  fat          Float
  unitName     String?
  gramsPerUnit Float?
  createdById  String?
  createdBy    User?     @relation("CustomFoods", fields: [createdById], references: [id], onDelete: Cascade)
  createdAt    DateTime  @default(now())

  mealItems    MealItem[]
}

model NutritionProfile {
  id            String        @id @default(uuid())
  userId        String        @unique
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  sex           Sex
  birthDate     DateTime
  heightCm      Float
  // Solo se usa si el usuario no tiene ninguna revisión corporal con peso.
  weightKg      Float?
  activityLevel ActivityLevel
  goal          NutritionGoal
  updatedAt     DateTime      @updatedAt
}

// Menú semanal.
// - isTemplate = false: menú de un cliente (userId = el cliente).
// - isTemplate = true: plantilla que se copia o se asigna. userId = entrenador que la creó,
//   o null para las plantillas globales (las gestiona el ADMIN).
model MealPlan {
  id           String   @id @default(uuid())
  name         String
  description  String?
  isTemplate   Boolean  @default(false)
  userId       String?
  user         User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Entrenador que asignó este menú al cliente (null si lo creó el propio cliente).
  assignedById String?
  assignedBy   User?    @relation("AssignedMealPlans", fields: [assignedById], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())
  updatedAt   DateTime @updatedAt

  meals       Meal[]
}

model Meal {
  id         String   @id @default(uuid())
  mealPlanId String
  mealPlan   MealPlan @relation(fields: [mealPlanId], references: [id], onDelete: Cascade)
  dayOfWeek  Int
  name       String
  order      Int

  items      MealItem[]
}

model MealItem {
  id     String @id @default(uuid())
  mealId String
  meal   Meal   @relation(fields: [mealId], references: [id], onDelete: Cascade)
  foodId String
  food   Food   @relation(fields: [foodId], references: [id])
  grams  Float
}

// Interruptores de módulos (ver backend/src/access). Sin fila = módulo activado.
model ModuleSetting {
  module    String   @id
  enabled   Boolean
  updatedAt DateTime @updatedAt
}

// Excepción por usuario: fuerza un módulo activado o desactivado por encima de su plan.
model UserModuleOverride {
  userId  String
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  module  String
  enabled Boolean

  @@id([userId, module])
}

// Conversación con el asistente IA. Los mensajes del usuario del día cuentan para el límite diario.
model AiMessage {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String // "user" | "assistant"
  content   String
  // "Nueva conversación" archiva en vez de borrar: los mensajes siguen contando para el límite del día.
  archived  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

// Configuración del asistente IA de cada usuario (la edita él en Ajustes o un admin).
model AiSettings {
  userId          String   @id
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tone            String   @default("friendly") // friendly | technical | motivational
  detail          String   @default("brief") // brief | detailed
  goal            String?
  limitations     String?
  // Qué datos del usuario puede usar la IA.
  shareTraining   Boolean  @default(true)
  shareSessions   Boolean  @default(true)
  shareRevisions  Boolean  @default(true)
  shareNutrition  Boolean  @default(true)
  // Solo admin. null = lo que diga su plan (o sin límite si usa su propia clave).
  dailyLimit      Int?
  // Clave de API propia, cifrada (AES-256-GCM). Nunca se devuelve; solo los 4 últimos caracteres.
  apiKeyEncrypted String?
  apiKeyLast4     String?
  updatedAt       DateTime @updatedAt
}
