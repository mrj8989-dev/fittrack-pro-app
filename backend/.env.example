DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fittrack_pro
# Genera uno con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d
PORT=3000

# ── Asistente IA (opcional) ──────────────────────────────────────────
# Clave de Anthropic del servidor (https://console.anthropic.com). Sin ella, el asistente solo
# funciona para los usuarios que pongan su propia clave en Ajustes.
ANTHROPIC_API_KEY=
# Tope de mensajes al día entre todos los usuarios que usan la clave del servidor (por defecto 200;
# 0 = la clave del servidor no se usa). Quien pone su propia clave no cuenta.
AI_SERVER_DAILY_LIMIT=
# Modelo del asistente (por defecto, claude-opus-5-5).
AI_MODEL=
# Secreto para cifrar las claves de API propias de los usuarios. Si se deja vacío se deriva de
# JWT_SECRET; si cambia, los usuarios tendrán que volver a introducir su clave.
AI_KEYS_SECRET=

# ── Fotos subidas ────────────────────────────────────────────────────
# Carpeta de las fotos (por defecto public/uploads). En producción, un volumen persistente.
UPLOADS_DIR=
# Secreto para firmar los enlaces a las fotos de revisiones (privadas). Vacío = se usa JWT_SECRET.
UPLOADS_SECRET=

# ── Seguridad ────────────────────────────────────────────────────────
# Intentos por minuto y por IP en login/registro/cambio de contraseña (por defecto 10 en producción).
AUTH_THROTTLE_LIMIT=
# Peticiones por minuto y por IP en el resto de la API (por defecto 300 en producción).
THROTTLE_LIMIT=

# ── Seeder (npm run seed) ────────────────────────────────────────────
# Admin real: se crea solo si se definen los dos (contraseña de 12 caracteres o más).
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Usuarios demo con contraseña pública: por defecto sí en desarrollo y no en producción.
# En producción, SEED_DEMO=true crea solo cliente y entrenador demo (nunca un admin demo).
SEED_DEMO=
